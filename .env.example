# Local Ollama Configuration (100% Offline, Zero Cloud API Keys Required)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
PROMPT_VERSION=v3

# Database URL - Native Local MongoDB (Zero Docker Required!)
DATABASE_URL=mongodb://localhost:27017/devdb

# Optional Local SQLite File:
# DATABASE_URL=sqlite:///dev.db
